# Anthropic — for site discovery
ANTHROPIC_API_KEY=sk-ant-...

# Resend — for sending email (resend.com, free tier = 3k/month)
RESEND_API_KEY=re_...

# Who gets the email
TO_EMAIL=you@example.com

# Sender address (must be a verified domain in Resend)
FROM_EMAIL=parrticles <daily@yourdomain.com>

# Public URL of this deployed app (no trailing slash)
APP_URL=https://your-app.railway.app

# Hour to send (UTC, 24h). 9 = 9 AM UTC
SEND_HOUR_UTC=9

# Where to store the SQLite DB (Railway: use a volume mount path)
DB_PATH=/data/parrticles.db
